# Copy to .env.local. Never commit .env.local.

# The app connects as bolt_app (restricted by Row Level Security).
DATABASE_URL=postgresql://bolt_app:local-dev-only@127.0.0.1:54329/bolt_events
# Owner connection: used only by db:migrate and admin:create, never by the running app.
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/bolt_events
BOLT_APP_PASSWORD=local-dev-only
# Optional: DATABASE_SSL=disable | no-verify ; DATABASE_CA_CERT=<pem text> ; DATABASE_CA_FILE=<path, for scripts> ; DATABASE_POOL_MAX=10

# Public address of the site, no trailing slash.
APP_URL=http://localhost:3000
# 32+ random bytes, hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Signs booking links and encrypts integration secrets. Changing it invalidates both.
APP_SECRET=
# Protects /api/cron/notifications
CRON_SECRET=
# Optional: TRUSTED_PROXY_HOPS=1   (2 when a CDN sits in front of the host's proxy)
# Optional: BOOKING_LIMIT_PER_IP=30   (bookings per 10 minutes per IP)

# Used once by: npm run admin:create
ADMIN_EMAIL=admin@example.test
ADMIN_NAME=Administrator
ADMIN_PASSWORD=change-me-please
