# Serve index.html at the site root
DirectoryIndex index.html

RewriteEngine On

# Force www-less / https is assumed to be handled by the host already.

# 0) Legacy URLs from the old site structure (301, permanent).
#    Two go to their specific new page; everything else no longer has a
#    matching page, so it goes to the home page instead of 404-ing.
RewriteRule ^about-us/?$ /about [R=301,L,NC]
RewriteRule ^contact-us/?$ /contact [R=301,L,NC]
RewriteRule ^second-hand-saree-buyers-in-chennai/?$ / [R=301,L,NC]
RewriteRule ^old-pattu-saree-buyers-in-anna-nagar/?$ / [R=301,L,NC]
RewriteRule ^old-pattu-saree-buyers-in-chennai-2/?$ / [R=301,L,NC]
RewriteRule ^old-silk-saree-buyers-in-t-nagar/?$ / [R=301,L,NC]
RewriteRule ^old-silk-saree-buyers-in-chennai-2/?$ / [R=301,L,NC]
RewriteRule ^pattu-saree-blouse-designs-2022/?$ / [R=301,L,NC]

# 1) Redirect requests that still end in .html to the clean URL (301, permanent)
#    e.g. /about.html -> /about   and   /index.html -> /
RewriteCond %{THE_REQUEST} \s/+index\.html[?\s] [NC]
RewriteRule ^index\.html$ /? [R=301,L]

RewriteCond %{THE_REQUEST} \s/+([^.\s]+)\.html[?\s] [NC]
RewriteRule ^ /%1 [R=301,L]

# 2) Internally serve the matching .html file for a clean URL request,
#    without changing what shows in the browser's address bar
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^.]+)$ $1.html [L]
